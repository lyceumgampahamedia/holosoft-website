{
  "name": "holosoft-react-suite",
  "version": "1.3.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB,CMS -c auto \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:cms\"",
    "dev:api": "npm run dev --workspace @holosoft/api",
    "dev:web": "npm run dev --workspace @holosoft/website",
    "dev:cms": "npm run dev --workspace @holosoft/cms",
    "build": "npm run build --workspace @holosoft/website && npm run build --workspace @holosoft/cms",
    "start": "npm run start --workspace @holosoft/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
